# Environment Configuration for Video Calling System
# Copy this to .env in your backend root directory

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=clinic_db

# Agora.io Configuration
# Get these from https://console.agora.io/
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (optional)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Secret (if using authentication)
JWT_SECRET=your_jwt_secret_here

# Push Notification Configuration (optional for mobile)
FCM_SERVER_KEY=your_firebase_server_key
APNS_KEY_ID=your_apple_push_key_id
APNS_TEAM_ID=your_apple_team_id

# Frontend Environment Variables
# Copy these to .env in your React app root directory
REACT_APP_AGORA_APP_ID=your_agora_app_id_here
REACT_APP_API_BASE_URL=http://localhost:3001/api
REACT_APP_ENVIRONMENT=development